# ---- Core (required)
DATABASE_URL=postgres://tremly:tremly@localhost:5432/tremly
APP_URL=http://localhost:3000
# openssl rand -hex 32
APP_SECRET=change-me-to-a-64-char-random-hex-string-0000000000000000000000
# Protects /api/cron/* (send as Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=change-me-cron-secret

# ---- Payments: Moyasar (REQUIRED for online payment; leave empty to allow cash-only bookings)
# Use sk_test_/pk_test_ keys until merchant activation is approved.
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
# The secret token configured on the Moyasar dashboard webhook
MOYASAR_WEBHOOK_SECRET=

# ---- SMS / OTP: unifonic | taqnyat | console (development only — prints OTP to server log) | none
SMS_PROVIDER=console
UNIFONIC_APP_SID=
TAQNYAT_BEARER_TOKEN=
SMS_SENDER_ID=TREMLY

# ---- Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=TREMLY <no-reply@tremly.sa>

# ---- WhatsApp Business Cloud API (requires Meta-approved templates)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Storage (Supabase). Empty = local ./public/uploads (development only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=tremly-media

# ---- Analytics (GA4 measurement ID)
NEXT_PUBLIC_GA_ID=
